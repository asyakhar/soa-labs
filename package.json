{
  "name": "ticket-service-openapi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "redocly lint openapi.yaml --max-problems 100",
    "validate": "node scripts/validate.cjs",
    "bundle": "redocly bundle openapi.yaml -o openapi.bundle.json",
    "vendor": "node scripts/vendor.cjs",
    "check": "npm run lint && npm run validate && npm run bundle",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@redocly/cli": "2.53.3",
    "swagger-ui-dist": "5.33.0"
  }
}
